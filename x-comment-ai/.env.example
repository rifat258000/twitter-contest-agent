# =========================================================
#  X Comment AI — Environment Variables
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real .env file to git.
# =========================================================

# --- Groq API ---
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_real_groq_api_key_here

# Model to use. Recommended:
#   - llama-3.3-70b-versatile  (best quality, slightly slower)
#   - llama-3.1-8b-instant     (fastest, good enough for short comments)
GROQ_MODEL=llama-3.3-70b-versatile

# Max tokens for the generated comment (keep small — X comments are short)
GROQ_MAX_TOKENS=200

# Sampling temperature (0.0 = deterministic, 1.0 = creative). 0.8 feels natural.
GROQ_TEMPERATURE=0.8

# --- twscrape ---
# Path to the SQLite DB twscrape uses to store accounts/cookies.
TWSCRAPE_DB_PATH=accounts/accounts.db

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Default reply language hint passed to the LLM:
#   auto   -> mirror the language of the original post
#   en     -> always English
#   bn     -> always Bengali
DEFAULT_REPLY_LANG=auto
