# Telegram bot (required to post)
# Create a bot with @BotFather on Telegram to get the token.
# Add the bot to your channel/group as admin, then send a message and use
# `https://api.telegram.org/bot<TOKEN>/getUpdates` to find the chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ollama (local LLM) — optional. If not set or unreachable, agent falls back to regex extraction.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Scraping
# twscrape requires real X (Twitter) accounts. Add them with:
#   twscrape add_accounts accounts.txt username:password:email:email_password
# See: https://github.com/vladkens/twscrape
# If no accounts are configured, the agent falls back to Nitter HTML scraping.
TWSCRAPE_DB_PATH=./data/twscrape.db

# Comma-separated list of Nitter instances to try for fallback scraping.
NITTER_INSTANCES=https://nitter.net,https://nitter.privacydev.net,https://nitter.poast.org

# Engagement ranking weights
WEIGHT_LIKES=1.0
WEIGHT_RETWEETS=2.0
WEIGHT_REPLIES=1.5
WEIGHT_QUOTES=2.0
WEIGHT_VIEWS=0.001

# Polling interval (minutes)
POLL_INTERVAL_MINUTES=30

# Max tweets to consider per search query per run
MAX_TWEETS_PER_QUERY=50

# Minimum engagement score to post (prevents spam)
MIN_ENGAGEMENT_SCORE=10

# Post the top N ranked tweets per run (after dedup)
TOP_N_PER_RUN=5

# SQLite dedup DB
DEDUP_DB_PATH=./data/posted.db
